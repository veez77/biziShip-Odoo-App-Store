<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_biziship_pallet_photos_wizard_form" model="ir.ui.view">
        <field name="name">biziship.pallet.photos.wizard.form</field>
        <field name="model">biziship.pallet.photos.wizard</field>
        <field name="arch" type="xml">
            <form string="Shipment Photos" class="biziship-modern-wizard">
                <div class="biziship-pallet-wizard-container">
                    <div class="mb-3 d-flex justify-content-between align-items-center">
                        <div>
                            <h2 class="mb-1" style="font-weight: 800; color: #0f172a;">Shipment Photos</h2>
                            <p class="text-muted mb-0">Attach photos of each pallet for this shipment.</p>
                        </div>
                        <button name="action_download_zip_all" type="object" string="Download All (ZIP)"
                                class="btn btn-outline-secondary" icon="fa-download"/>
                    </div>

                    <field name="sale_order_id" invisible="1"/>
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <field name="new_pallet_name" placeholder="Pallet name (optional)" nolabel="1"
                               class="biziship-search-input" style="max-width: 280px;"/>
                        <button name="action_add_pallet" type="object" string="+ Add Pallet"
                                class="btn btn-primary"/>
                        <button name="action_refresh" type="object" string="Refresh"
                                icon="fa-refresh" class="btn btn-link text-muted"/>
                    </div>

                    <div invisible="not status_message or status_message == ''"
                         style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 12px; padding: 20px; margin-bottom: 16px; text-align: center;">
                        <field name="status_message" nolabel="1" style="display: block; color: #475569; font-size: 1rem; font-weight: 500;"/>
                    </div>

                    <field name="pallet_line_ids" nolabel="1">
                        <list editable="bottom" create="0" delete="0">
                            <field name="name" string="Pallet"/>
                            <field name="photo_count" string="Photos" widget="integer" readonly="1"/>
                            <button name="action_open_upload_dialog" type="object" string="Upload" class="btn-sm btn-outline-primary"/>
                            <button name="action_download_zip" type="object" icon="fa-download" title="Download this pallet's photos"/>
                            <button name="action_delete_pallet" type="object" icon="fa-trash" title="Delete pallet"
                                    confirm="Delete this pallet and all its photos? This cannot be undone."/>
                        </list>
                    </field>

                    <!-- Photo thumbnails live here, as a plain form-level field, not a
                         tree column - Odoo's list renderer sets a native tooltip on Html
                         columns showing the raw field source, which a tree cell can't
                         opt out of; a form field isn't subject to that renderer at all. -->
                    <field name="all_photos_html" nolabel="1"/>
                </div>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_biziship_pallet_photo_upload_wizard_form" model="ir.ui.view">
        <field name="name">biziship.pallet.photo.upload.wizard.form</field>
        <field name="model">biziship.pallet.photo.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Photo">
                <field name="pallet_line_id" invisible="1"/>
                <group>
                    <field name="upload_file" filename="upload_filename" widget="binary" string="Photo"/>
                    <field name="upload_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_upload" type="object" string="Upload" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
